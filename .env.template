# Required
METACULUS_TOKEN=1234567890
# Mantic Crucible bot token (competitions.mantic.com), used only by --mode mantic.
# Personal, never donated; the same 40-char "Authorization: Token" shape as Metaculus.
MANTIC_TOKEN=

# Optional
OPENROUTER_API_KEY=1234567890
# General web research primaries: run You.com + Firecrawl concurrently when configured.
# YDC_API_KEY=
# FIRECRAWL_API_KEY=
# Nimble Agent Search runs only when both primary providers return no usable research.
# NIMBLE_API_KEY=
# Legacy Metaculus-donated OpenRouter key. Production model routes use explicit
# :free IDs and bypass the donated-key wrapper, so this is not needed there.
OAI_ANTH_OPENROUTER_KEY=1234567890
# Master switch for legacy donated-key routing. Mantic requires false.
# DONATED_OPENROUTER_KEY_ENABLED=true
ASKNEWS_CLIENT_ID=1234567890
ASKNEWS_SECRET=1234567890
# AskNews recommended safe defaults for development/local runs. Concurrency
# keeps a single in-flight call at a time across all models; the max RPS spaces
# calls out to avoid minute-level rate bursts and sits DELIBERATELY below the
# ASKNEWS_MAX_RPS code default in constants.py (an intentional override, not
# drift); tries/backoff absorb transient 429s without spiking traffic.
ASKNEWS_MAX_CONCURRENCY=1
ASKNEWS_MAX_RPS=0.2
ASKNEWS_MAX_TRIES=3
ASKNEWS_BACKOFF_SECS=2.0
# Legacy direct-provider key, not used by production model roles.
# ANTHROPIC_API_KEY=

# Financial data provider (yfinance + FRED) for economic/market questions
# FINANCIAL_DATA_ENABLED=true
# FRED_API_KEY=your_free_key_from_fred.stlouisfed.org

# SEC EDGAR fair-access contact (research/sec_edgar.py): sent as the User-Agent
# "metaculus-bot <email>"; the client refuses to make any request without it.
# SEC_EDGAR_CONTACT_EMAIL=you@example.com

# Optional native web search via OpenRouter. Production leaves this disabled;
# if enabled locally, NATIVE_SEARCH_MODEL must be an explicit :free model slug.
# Defaults live in constants.py:
# NATIVE_SEARCH_DEFAULT_MODEL, NATIVE_SEARCH_REASONING_EFFORT_DEFAULT,
# NATIVE_SEARCH_VERBOSITY_DEFAULT, and NATIVE_SEARCH_TIMEOUT. Model, effort, and
# verbosity are env-overridable (NATIVE_SEARCH_MODEL /
# NATIVE_SEARCH_REASONING_EFFORT / NATIVE_SEARCH_VERBOSITY); the timeout is not.
# NATIVE_SEARCH_ENABLED=false
# NATIVE_SEARCH_MODEL=nvidia/nemotron-3.5-lightning:free

# Direct Gemini grounded search is disabled in production to prevent quota-to-billing
# spillover. If explicitly enabled locally, it is pinned to the free-tier model.
# GOOGLE_API_KEY=
# GEMINI_SEARCH_ENABLED=false
# GEMINI_SEARCH_MODEL=gemini-2.5-flash

# Legacy OpenRouter Gemini routing toggle. No paid Gemini model is in the active roster.
# GEMINI_USE_DONATED_OPENROUTER_KEY=false

# Second-pass gap-fill research (no GOOGLE_API_KEY needed since the 2026-06-25
# resolver migration off grounded Gemini). Runs after first-pass research
# completes. A non-grounded OpenRouter analyzer (GAP_FILL_ANALYZER_MODEL in
# constants.py) identifies up to GAP_FILL_MAX_GAPS factual gaps; each is
# resolved via a parallel OpenAI native web search (GAP_FILL_RESOLVER_MODEL at
# GAP_FILL_RESOLVER_REASONING_EFFORT, via OpenRouter). Fails soft — forecast
# proceeds with first-pass research alone if anything errors.
# GAP_FILL_ENABLED=true

# Gap-fill v2: bounded agentic research loop (search_news / search_web / fetch /
# read_document tools) driven by GAP_FILL_V2_DRIVER_MODEL at
# GAP_FILL_V2_DRIVER_EFFORT. The driver override must be an OpenRouter :free model;
# the production workflow leaves this feature off because the reader uses Google APIs.
# Appends a citation-only findings artifact to the research bundle;
# soft-fails to "". Disabled in production to avoid direct Gemini calls.
# GAP_FILL_V2_ENABLED=false

# The Gemini URL-context rung is disabled in production; the resolution-source
# provider uses its local and network fetch rungs only.
# RESOLUTION_SOURCE_URL_CONTEXT_ENABLED=false

# The kill switch for the free TLS-impersonating retry of a direct-fetch 403
# (research/impersonated_fetch.py; the Tier-1 route=impersonate rung and gap-fill
# v2's fetch and read_document ladders). ON by default in code, the one research
# flag that is: no key, no model call, no spend, a host's 403 only, memoized per
# host for the run. No bot workflow sets it. Uncomment to fall straight through to
# the archive and the paid reader on a 403.
# RESOLUTION_SOURCE_IMPERSONATE_ENABLED=false

# Time-series anchor (numeric questions that route to a known FRED/yfinance
# series): renders a deterministic empirical-band anchor from the series' own
# history. Backtest-safe. ON in all prod workflows.
# TS_ANCHOR_ENABLED=true

# Disable OpenAI Agents SDK trace-export (we route via OpenRouter, not OpenAI)
OPENAI_AGENTS_DISABLE_TRACING=true

# Stacking disabled on all types. n=88 ablation: stacker hurts numeric CRPS and is
# <= median on binary; 2026-05-29 peer recompute found the stacker's base model
# (claude-opus-4.5) is itself a weak base binary forecaster. All default to true in
# code, so deploy/local config must set these false to keep the stacker off.
NUMERIC_STACKING_ENABLED=false
BINARY_STACKING_ENABLED=false
MC_STACKING_ENABLED=false

# Prediction-market snapshot timeout in seconds (runs in parallel with other
# research; default 150.0, see PREDICTION_MARKET_TIMEOUT in constants.py). The
# pipeline's worst case is 131.5s, so an override below that WARNs at provider
# init and will time out snapshots under load — leave it unset unless you have a
# reason.
# PREDICTION_MARKET_TIMEOUT=<seconds>
